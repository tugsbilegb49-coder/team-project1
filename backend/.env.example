DJANGO_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-server.example.com,localhost,127.0.0.1
POSTGRES_DB=worker_monitor
POSTGRES_USER=worker_monitor
POSTGRES_PASSWORD=replace-with-a-strong-password
REQUIRE_MONITORING_CONSENT=true
DJANGO_SECURE_SSL_REDIRECT=true
CORS_ALLOWED_ORIGINS=https://your-dashboard.example.com
CSRF_TRUSTED_ORIGINS=https://your-dashboard.example.com
